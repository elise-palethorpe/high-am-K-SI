#INFO: **** input file is /g/data/kx58/ep9149/exess/new_exess/high-am-K-SI/convergence_check/run_scf.py ****
#!/usr/bin/env python3
"""RHF on an xyz with either PySCF (CPU) or GPU4PySCF, using library-default or paper parameters."""
import argparse
import time
from pathlib import Path


def read_xyz(path):
    lines = path.read_text().splitlines()
    nat = int(lines[0].strip())
    return "\n".join(" ".join(ln.split()[:4]) for ln in lines[2 : 2 + nat])


ap = argparse.ArgumentParser()
ap.add_argument("--xyz", required=True, type=Path)
ap.add_argument("--basis", required=True)
ap.add_argument("--code", choices=["pyscf", "gpu4pyscf"], required=True)
ap.add_argument("--params", choices=["default", "paper"], required=True)
ap.add_argument("--max-cycle", type=int, default=None, help="override max_cycle")
ap.add_argument("--conv-tol", type=float, default=None, help="override conv_tol")
ap.add_argument("--direct-scf-tol", type=float, default=None, help="override direct_scf_tol (integral screening)")
args = ap.parse_args()

from pyscf import gto

mol = gto.M(atom=read_xyz(args.xyz), basis=args.basis, unit="Angstrom", verbose=4, cart=False)
if args.code == "pyscf":
    from pyscf import scf as backend
else:
    from gpu4pyscf import scf as backend

mf = backend.RHF(mol)
if args.params == "paper":
    mf.direct_scf = True
    mf.direct_scf_tol = 3.16e-11
    mf.max_cycle = 15
    mf.conv_tol = 1e-18
    mf.conv_tol_grad = 1e6
    mf.diis_space = 8
    mf.diis_start_cycle = 1
    dm0 = mf.get_init_guess(mol, key="atom")
else:
    dm0 = None  # library default guess (minao)

if args.max_cycle is not None:
    mf.max_cycle = args.max_cycle
if args.conv_tol is not None:
    mf.conv_tol = args.conv_tol
if args.direct_scf_tol is not None:
    mf.direct_scf_tol = args.direct_scf_tol

print(f"code = {args.code}, params = {args.params}, basis = {args.basis}, nbf = {mol.nao_nr()}, max_cycle = {mf.max_cycle}, conv_tol = {mf.conv_tol}, conv_tol_grad = {mf.conv_tol_grad}, direct_scf_tol = {mf.direct_scf_tol}")
t0 = time.perf_counter()
e = mf.kernel(dm0=dm0)
print(f"\nconverged = {mf.converged}")
print(f"E HF = {e:.15f}")
print(f"total wall time = {time.perf_counter() - t0:.1f} s")
#INFO: ******************** input file end ********************


