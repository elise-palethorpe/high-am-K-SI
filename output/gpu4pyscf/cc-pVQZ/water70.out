#!/usr/bin/env python3
from __future__ import annotations

import argparse
import time
from pathlib import Path


def read_xyz(path: Path) -> str:
    lines = path.read_text().splitlines()
    nat = int(lines[0].strip())
    body = lines[2 : 2 + nat]
    atoms = []
    for ln in body:
        parts = ln.split()
        atoms.append(f"{parts[0]} {parts[1]} {parts[2]} {parts[3]}")
    return "\n".join(atoms)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--xyz", required=True, type=Path)
    ap.add_argument("--basis", default="cc-pVTZ")
    ap.add_argument("--max-cycle", type=int, default=15)
    ap.add_argument("--conv-tol", type=float, default=1e-8)
    ap.add_argument("--conv-tol-grad", type=float, default=1e6)
    ap.add_argument("--direct-scf-tol", type=float, default=3.16e-11)
    ap.add_argument("--verbose", type=int, default=4)
    args = ap.parse_args()

    from pyscf import gto
    from gpu4pyscf import scf as gscf
    import cupy as cp

    atom_str = read_xyz(args.xyz)

    mol = gto.M(
        atom=atom_str,
        basis=args.basis,
        unit="Angstrom",
        verbose=args.verbose,
        cart=False,
    )
    nbf = mol.nao_nr()

    mf = gscf.RHF(mol)
    mf.direct_scf = True
    mf.direct_scf_tol = args.direct_scf_tol
    mf.max_cycle = args.max_cycle
    mf.conv_tol = args.conv_tol
    mf.conv_tol_grad = args.conv_tol_grad
    mf.diis_space = 8
    mf.diis_start_cycle = 1

    _orig_get_veff = mf.get_veff

    def timed_get_veff(*a, **kw):
        cp.cuda.Device().synchronize()
        t0 = time.perf_counter()
        result = _orig_get_veff(*a, **kw)
        cp.cuda.Device().synchronize()
        wall = time.perf_counter() - t0
        print(f"    CPU time for vj and vk on gpu {wall:20.2f} sec, wall time {wall:10.2f} sec")
        return result

    mf.get_veff = timed_get_veff

    dm0 = mf.get_init_guess(mol, key="atom")

    print(f"basis = {args.basis}")
    print(f"number of NR cGTOs = {nbf}")
    print(f"direct_scf_tol = {args.direct_scf_tol}")
    print(f"max_cycle = {args.max_cycle}")
    print(f"conv_tol = {args.conv_tol}")
    print(f"conv_tol_grad = {args.conv_tol_grad}")

    e_tot = mf.kernel(dm0=dm0)

    print(f"\nE HF = {e_tot:.15f}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
